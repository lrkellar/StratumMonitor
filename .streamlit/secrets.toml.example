# Paste this into Streamlit Cloud: App settings > Secrets (and fill it in).
# For running on your own PC, save it as .streamlit/secrets.toml instead.

[yolink]
uaid = "ua_XXXXXXXXXXXX"        # YoLink app > Account > Advanced Settings > Personal Access Credentials
secret = "sec_XXXXXXXXXXXX"

[passwords]                     # one line per person who may sign in:  name = "password"
lance = "change-me"
