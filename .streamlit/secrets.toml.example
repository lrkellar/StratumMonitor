# Paste this into Streamlit Cloud: your app > Settings > Secrets (and fill it in).
# For running on your own PC, save it as .streamlit/secrets.toml instead.

admins = ["admin"]              # names that get the Accounts panel. Keep this line above the [sections].

[yolink]
uaid = "ua_XXXXXXXXXXXX"        # YoLink app > Account > Advanced Settings > Personal Access Credentials
secret = "sec_XXXXXXXXXXXX"

[passwords]                     # one line per person who may sign in
# Start with plain passwords, sign in as admin, then use Accounts > "Make secrets line"
# to get a hashed line for each person and paste those here in place of these.
admin = "change-me"
stratum = "change-me-too"
